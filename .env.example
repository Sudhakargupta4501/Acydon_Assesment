# Application Configuration
APP_NAME="JobFlow Ingestion Platform"
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# Local SQLite default (uncomment PostgreSQL URL for production/Neon/Supabase)
DATABASE_URL=sqlite:///./jobflow.db
# DATABASE_URL=postgresql://user:password@localhost:5432/jobflow_db

# Ingestion Settings
REQUEST_TIMEOUT=10
MIN_REQUEST_INTERVAL=2
MAX_RETRIES=3
BACKOFF_FACTOR=2

# Primary & Fallback Sources
PRIMARY_SOURCE_TYPE=rss
PRIMARY_SOURCE_URL=https://weworkremotely.com/remote-jobs.rss
FALLBACK_SOURCE_TYPE=api
FALLBACK_SOURCE_URL=https://arbeitnow.com/api/job-board-api

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
